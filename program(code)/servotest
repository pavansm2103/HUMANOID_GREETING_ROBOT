from adafruit_servokit import ServoKit
import time

# Initialize PCA9685
kit = ServoKit(channels=16)

# 10 servos connected to CH0 to CH9
servos = list(range(10))

print("10 Servo Test Started")
print("----------------------")

# Start at 0 degrees
print("All servos -> 0 degrees")
for servo in servos:
    kit.servo[servo].angle = 0

time.sleep(2)

# Move to 30 degrees
print("All servos -> 30 degrees")
for servo in servos:
    kit.servo[servo].angle = 30

time.sleep(2)

# Move to 60 degrees
print("All servos -> 60 degrees")
for servo in servos:
    kit.servo[servo].angle = 60

time.sleep(2)

# Move to 90 degrees
print("All servos -> 90 degrees")
for servo in servos:
    kit.servo[servo].angle = 90

time.sleep(2)

# Return to 0 degrees
print("All servos -> 0 degrees")
for servo in servos:
    kit.servo[servo].angle = 0

time.sleep(2)

print("----------------------")
print("10 Servo Test Completed!")
